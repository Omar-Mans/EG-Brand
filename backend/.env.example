# Copy to .env and fill in. Nothing here is required to run locally: without AI keys the app uses mock AI,
# and without Meta keys it uses mock social accounts.

# --- Core
DATABASE_URL=sqlite:///./egbrand.db
# DATABASE_URL=postgresql+psycopg://egbrand:egbrand@localhost:5432/egbrand
JWT_SECRET=change-me-to-a-long-random-string-of-at-least-32-chars
# Fernet key for social tokens. Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=
CORS_ORIGINS=http://localhost:3000
PUBLIC_BASE_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000
ADMIN_EMAILS=
EMBEDDED_WORKER=true

# --- AI (LiteLLM model names, comma-separated fallback chains)
AI_MODE=auto
GROQ_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
LLM_FAST_MODELS=groq/qwen/qwen3-32b
LLM_QUALITY_MODELS=anthropic/claude-sonnet-5-5,groq/qwen/qwen3-32b
# Prices per 1M tokens when the gateway does not know a model: model=in:out;model2=in:out
LLM_PRICE_OVERRIDES=
DEFAULT_MONTHLY_AI_BUDGET_USD=5

# --- Storage for rendered designs (Instagram must be able to download them: use a public bucket in production)
STORAGE_BACKEND=local
UPLOAD_DIR=./uploads
S3_BUCKET=
S3_ENDPOINT_URL=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_PUBLIC_BASE_URL=

# --- Meta (Facebook + Instagram publishing, Ads)
SOCIAL_MODE=auto
META_APP_ID=
META_APP_SECRET=
META_GRAPH_VERSION=v23.0
